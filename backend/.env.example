# ===== 应用基础 =====
PROJECT_NAME=ccwy_blog
ENVIRONMENT=local                      # local | staging | production

# JWT 签名密钥 —— 生产环境务必改为随机长字符串（如 openssl rand -hex 32）
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=11520      # 令牌有效期（分钟），约 8 天

# ===== 初始超级管理员 =====
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me

# ===== 上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ===== OSS 冷备（可选，留空则仅本地存储；配置后本地 + OSS 双写）=====
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
